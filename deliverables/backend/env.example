# 叩门·社工个案面谈 AI 陪练舱 —— 后端环境变量样例
# 复制为 .env 后按需修改；所有键均为可选，缺省即进入开发模式。
# 生产环境严禁把真实密钥提交到版本库。

# ---------- 应用 ----------
APP_ENV=dev
DEBUG=false
API_V1_PREFIX=/api/v1
PORT=8000
WORKERS=4
LOG_LEVEL=INFO
LOG_JSON=true
BODY_LIMIT_BYTES=524288
AUTO_CREATE_SCHEMA=true
SEED_SCENARIOS_ON_STARTUP=true

# 逗号分隔；开发期默认放行本地前端
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*

# ---------- 数据库 ----------
# 本机开发默认 SQLite：sqlite+aiosqlite:///./knock_dev.db
# 生产 / 本机 MySQL：mysql+aiomysql://knock:knock@127.0.0.1:3306/knock?charset=utf8mb4
# 兼容 PostgreSQL：postgresql+asyncpg://knock:knock@postgres:5432/knock
DATABASE_URL=sqlite+aiosqlite:///./knock_dev.db
DATABASE_READ_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------- Redis（留空则退化为进程内实现，仅适合单进程开发） ----------
REDIS_URL=

# ---------- AI（智谱 GLM，OpenAI 兼容端点） ----------
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4-flash-250414
GLM_FALLBACK_MODELS=glm-z1-flash,glm-4.7-flash
GLM_TIMEOUT_MS=45000
GLM_DAILY_CAP=800
GLM_RPM_PER_IP=20
GLM_CONCURRENCY=2
GLM_CACHE_TTL_SEC=600
GLM_CACHE_MAX=300
GLM_BREAKER_FAILURE_THRESHOLD=0.5
GLM_BREAKER_MIN_SAMPLES=10
GLM_BREAKER_OPEN_SEC=30
GLM_MAX_RETRIES=1

# ---------- 认证 ----------
# 生产必须替换：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-please-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
JWT_GUEST_TTL_HOURS=24

# ---------- Argon2id ----------
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ---------- 观测 ----------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=knock-backend
SENTRY_DSN=

# ---------- 限流 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=60

# ---------- 二期预留（当前版本不消费） ----------
FIELD_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- 静态托管（留空则纯 API，不托管前端） ----------
# 单端口部署时指向已构建的前端产物目录
STATIC_DIR=
