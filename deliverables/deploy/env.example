# docker-compose.prod.yml 的环境变量模板
# 用法：cp deploy/env.example deploy/.env && 填入真实值（.env 不入库，见 .gitignore）
# 键名与 deliverables/backend/app/core/config.py 一一对应（backend 确认的最终契约）

# ── 应用 ──────────────────────────────────────────────
APP_ENV=prod
DEBUG=false
API_V1_PREFIX=/api/v1
PORT=8000
WORKERS=4
LOG_LEVEL=INFO
LOG_JSON=true
BODY_LIMIT_BYTES=524288
CORS_ORIGINS=https://www.knock.example.com,https://admin.knock.example.com
ALLOWED_HOSTS=api.knock.example.com,www.knock.example.com,admin.knock.example.com
AUTO_CREATE_SCHEMA=false
SEED_SCENARIOS_ON_STARTUP=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=60

# ── 数据库（机密）──────────────────────────────────────
# 驱动 mysql+aiomysql（aiomysql + PyMySQL）；Compose 单机阶段 api 直连 mysql 容器，
# 生产集群阶段连接云托管 MySQL 实例或独立 MySQL 实例，aiomysql 自带连接池，无需额外池化中间件
DATABASE_URL=mysql+aiomysql://knock:__CHANGE_ME__@mysql:3306/knock?charset=utf8mb4
DATABASE_READ_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis（机密）──────────────────────────────────────
REDIS_URL=redis://:__CHANGE_ME__@redis:6379/0

# ── AI 网关（GLM_API_KEY 机密）────────────────────────
GLM_API_KEY=__CHANGE_ME__
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4.7-flash
GLM_FALLBACK_MODELS=glm-4.5-flash,glm-4-flash
GLM_TIMEOUT_MS=45000
GLM_DAILY_CAP=800
GLM_RPM_PER_IP=20
GLM_CONCURRENCY=2
GLM_CACHE_TTL_SEC=600
GLM_CACHE_MAX=300
GLM_BREAKER_FAILURE_THRESHOLD=0.5
GLM_BREAKER_MIN_SAMPLES=10
GLM_BREAKER_OPEN_SEC=30
GLM_MAX_RETRIES=1

# ── 认证（JWT_SECRET 机密）────────────────────────────
JWT_SECRET=__CHANGE_ME_32_BYTES_RANDOM__
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
JWT_GUEST_TTL_HOURS=24
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ── 可观测 ────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=knock-backend
SENTRY_DSN=

# ── Compose 内部使用（供 mysql/redis 容器初始化）────
# MYSQL_* 由官方 mysql:8.0 入口脚本读取；MYSQL_EXPORTER_PASSWORD 供 mysql/init 创建监控只读账号
MYSQL_DB=knock
MYSQL_USER=knock
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_ROOT_PASSWORD=__CHANGE_ME_ROOT__
MYSQL_EXPORTER_PASSWORD=__CHANGE_ME_EXPORTER__
REDIS_PASSWORD=__CHANGE_ME__
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__CHANGE_ME__
