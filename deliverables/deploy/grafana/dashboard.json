        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{path!~\".*/ai/.*\"}[5m])))",
          "legendFormat": "P99",
          "range": true,
          "refId": "C"
